---
import type { LocalizedText } from '../config/site';
import { siteConfig } from '../config/site';

interface Props {
	title: LocalizedText;
	description: string;
	bgDataUri: string;
	author?: string;
	canonicalPath?: string;
	preloadImage?: string;
	ogImage?: {
		url: string;
		width: number;
		height: number;
	};
	jsonLd?: Record<string, unknown>;
	noindex?: boolean;
}

const {
	title,
	description,
	bgDataUri,
	author = siteConfig.name,
	canonicalPath,
	preloadImage,
	ogImage,
	jsonLd,
	noindex = false,
} = Astro.props;

const siteOrigin = (Astro.site?.toString() || siteConfig.siteUrl).replace(/\/$/, '');
const canonicalUrl = canonicalPath ? `${siteOrigin}${canonicalPath}` : undefined;
const safeJsonLd = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="zh-CN" data-theme-mode="system" data-lang="zh">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{
			preloadImage && (
				<link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
			)
		}
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="description" content={description} />
		<meta name="author" content={author} />
		<meta name="generator" content={Astro.generator} />
		<title data-zh={title.zh} data-en={title.en}>{title.zh}</title>

		{
			canonicalUrl && ogImage && (
				<>
					<meta property="og:type" content="profile" />
					<meta property="og:site_name" content={author} />
					<meta property="og:title" content={title.zh} />
					<meta property="og:description" content={description} />
					<meta property="og:url" content={canonicalUrl} />
					<meta property="og:locale" content="zh_CN" />
					<meta property="og:image" content={ogImage.url} />
					<meta property="og:image:width" content={String(ogImage.width)} />
					<meta property="og:image:height" content={String(ogImage.height)} />
					<meta name="twitter:card" content="summary_large_image" />
					<meta name="twitter:title" content={title.zh} />
					<meta name="twitter:description" content={description} />
					<meta name="twitter:image" content={ogImage.url} />
				</>
			)
		}

		{safeJsonLd && <script type="application/ld+json" set:html={safeJsonLd} />}

		<script is:inline>
			(() => {
				const root = document.documentElement;
				try {
					const rawTheme = localStorage.getItem('theme');
					const theme =
						rawTheme === 'light' || rawTheme === 'dark' || rawTheme === 'system'
							? rawTheme
							: 'system';
					const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					root.classList.toggle('dark', theme === 'dark' || (theme === 'system' && prefersDark));
					root.dataset.themeMode = theme;

					const savedLang = localStorage.getItem('lang');
					const isCrawler =
						/bot|crawl|spider|slurp|google|bing|baidu|yandex|duckduck|sogou|bytespider|applebot/i.test(
							navigator.userAgent || '',
						);
					const browserLang = (navigator.languages?.[0] || navigator.language || '').toLowerCase();
					const lang =
						savedLang === 'en' || savedLang === 'zh'
							? savedLang
							: isCrawler || browserLang.startsWith('zh')
								? 'zh'
								: 'en';
					root.dataset.lang = lang;
					root.lang = lang === 'en' ? 'en' : 'zh-CN';
				} catch {}
			})();
		</script>
	</head>
	<body>
		<!-- Pre-blurred atmospheric background (zero runtime CSS blur filter) -->
		<div class="bg-backdrop" aria-hidden="true">
			<div class="bg-image" style={`background-image: url('${bgDataUri}')`}></div>
			<div class="bg-overlay"></div>
		</div>

		<slot />

		<script>
			type ThemeMode = 'light' | 'system' | 'dark';
			type LangMode = 'zh' | 'en';

			const root = document.documentElement;
			const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
			const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-value]');
			const langButtons = document.querySelectorAll<HTMLButtonElement>('[data-lang-value]');
			const i18nNodes = document.querySelectorAll<HTMLElement>('[data-i18n]');
			const ariaNodes = document.querySelectorAll<HTMLElement>('[data-aria-zh][data-aria-en]');
			const titleEl = document.querySelector<HTMLTitleElement>('title[data-zh][data-en]');

			function getInitialTheme(): ThemeMode {
				const mode = root.dataset.themeMode;
				return mode === 'light' || mode === 'dark' || mode === 'system' ? mode : 'system';
			}

			function getInitialLang(): LangMode {
				return root.dataset.lang === 'en' ? 'en' : 'zh';
			}

			function applyTheme(mode: ThemeMode): void {
				const isDark = mode === 'dark' || (mode === 'system' && mediaQuery.matches);
				root.classList.toggle('dark', isDark);
				root.dataset.themeMode = mode;
				themeButtons.forEach((btn) => {
					const active = btn.dataset.themeValue === mode;
					btn.setAttribute('aria-checked', String(active));
					btn.classList.toggle('is-active', active);
				});
			}

			function applyLang(lang: LangMode): void {
				root.dataset.lang = lang;
				root.lang = lang === 'en' ? 'en' : 'zh-CN';
				if (titleEl) {
					const nextTitle = titleEl.dataset[lang];
					if (nextTitle) document.title = nextTitle;
				}
				i18nNodes.forEach((node) => {
					const text = node.dataset[lang];
					if (text) node.textContent = text;
				});
				ariaNodes.forEach((node) => {
					const label = lang === 'en' ? node.dataset.ariaEn : node.dataset.ariaZh;
					if (label) {
						node.setAttribute('aria-label', label);
						if (node.hasAttribute('title')) {
							node.setAttribute('title', label);
						}
					}
				});
				langButtons.forEach((btn) => {
					const active = btn.dataset.langValue === lang;
					btn.setAttribute('aria-checked', String(active));
					btn.classList.toggle('is-active', active);
				});
			}

			let currentTheme = getInitialTheme();
			let currentLang = getInitialLang();
			applyTheme(currentTheme);
			applyLang(currentLang);

			themeButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const next = btn.dataset.themeValue as ThemeMode | undefined;
					if (!next) return;
					currentTheme = next;
					localStorage.setItem('theme', next);
					applyTheme(next);
				});
			});

			langButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const next = btn.dataset.langValue as LangMode | undefined;
					if (!next) return;
					currentLang = next;
					localStorage.setItem('lang', next);
					applyLang(next);
				});
			});

			mediaQuery.addEventListener('change', () => {
				if (currentTheme === 'system') {
					applyTheme('system');
				}
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg-overlay: rgba(241, 245, 249, 0.56);
		--card-bg: rgba(255, 255, 255, 0.9);
		--card-border: rgba(255, 255, 255, 0.85);
		--card-ring: #ffffff;
		--card-shadow:
			0 20px 40px -15px rgba(15, 23, 42, 0.14),
			0 4px 12px -2px rgba(15, 23, 42, 0.06);
		--text-primary: #1e293b;
		--text-secondary: #64748b;
		--blue-accent: #1d6fe8;
		--blue-accent-hover: #1558c0;
		--squircle-bg: #eff6ff;
		--squircle-bg-hover: #dbeafe;
		--cta-secondary-bg: #f1f5f9;
		--cta-secondary-hover: #e2e8f0;
		--cta-secondary-text: #334155;
		--track-bg: rgba(255, 255, 255, 0.68);
		--track-border: rgba(255, 255, 255, 0.75);
		--thumb-bg: rgba(255, 255, 255, 0.95);
		--control-text: #64748b;
		--control-text-active: #0f172a;
	}

	html.dark {
		--bg-overlay: rgba(10, 15, 28, 0.72);
		--card-bg: rgba(15, 23, 42, 0.84);
		--card-border: rgba(148, 163, 184, 0.18);
		--card-ring: #162033;
		--card-shadow:
			0 24px 48px -12px rgba(0, 0, 0, 0.55),
			0 4px 16px -2px rgba(0, 0, 0, 0.35);
		--text-primary: #f1f5f9;
		--text-secondary: #94a3b8;
		--blue-accent: #60a5fa;
		--blue-accent-hover: #3b82f6;
		--squircle-bg: rgba(30, 58, 138, 0.35);
		--squircle-bg-hover: rgba(30, 58, 138, 0.6);
		--cta-secondary-bg: rgba(51, 65, 85, 0.55);
		--cta-secondary-hover: rgba(51, 65, 85, 0.85);
		--cta-secondary-text: #e2e8f0;
		--track-bg: rgba(15, 23, 42, 0.65);
		--track-border: rgba(148, 163, 184, 0.2);
		--thumb-bg: rgba(51, 65, 85, 0.9);
		--control-text: #94a3b8;
		--control-text-active: #f8fafc;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html,
	body {
		font-family:
			-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'PingFang SC',
			'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body {
		min-width: 320px;
		color: var(--text-primary);
		overflow-x: hidden;
	}

	.bg-backdrop {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
	}

	.bg-image {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		transform: scale(1.04);
	}

	.bg-overlay {
		position: absolute;
		inset: 0;
		background: var(--bg-overlay);
		transition: background-color 300ms ease;
	}

	.page-wrapper {
		min-height: 100vh;
		min-height: 100dvh;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3.5rem 1rem 1rem;
	}

	@media (min-width: 640px) and (min-height: 700px) {
		.page-wrapper {
			padding: 4.5rem 1.25rem 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
		}
	}
</style>
