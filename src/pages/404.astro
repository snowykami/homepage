---
import TopControls from '../components/TopControls.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchNeoBlogProfile } from '../lib/neo-blog';

const profile = await fetchNeoBlogProfile();
---

<BaseLayout
	title={{
		zh: `404 - ${profile.name}`,
		en: `404 - ${profile.name}`,
	}}
	description={profile.description.zh}
	author={profile.name}
	bgDataUri={profile.bannerBgDataUri}
	noindex={true}
>
	<TopControls />
	<div class="page-wrapper">
		<main class="not-found-card">
			<h1 class="code">404</h1>
			<span class="accent-bar" aria-hidden="true"></span>
			<p class="message" data-i18n data-zh="页面不见了" data-en="Page not found">页面不见了</p>
			<a href="/" class="back-btn" data-i18n data-zh="返回主页" data-en="Back to Home">
				返回主页
			</a>
		</main>
	</div>
</BaseLayout>

<style>
	.not-found-card {
		width: 100%;
		max-width: 24rem;
		padding: 2.5rem 2rem;
		border-radius: 1.5rem;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		box-shadow: var(--card-shadow);
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.code {
		font-size: 3.5rem;
		line-height: 1;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--blue-accent);
	}

	.accent-bar {
		display: block;
		width: 1.75rem;
		height: 0.25rem;
		border-radius: 9999px;
		background: var(--blue-accent);
	}

	.message {
		margin-top: 0.15rem;
		font-size: 0.98rem;
		color: var(--text-secondary);
	}

	.back-btn {
		margin-top: 0.75rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.68rem 1.5rem;
		border-radius: 0.85rem;
		background: var(--blue-accent);
		color: #ffffff;
		font-size: 0.92rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			background-color 200ms ease,
			transform 200ms ease;
	}

	.back-btn:hover {
		background: var(--blue-accent-hover);
		transform: translateY(-1px);
	}

	.back-btn:focus-visible {
		outline: 2px solid var(--blue-accent);
		outline-offset: 2px;
	}
</style>
