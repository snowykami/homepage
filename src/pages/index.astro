---
import ProfileCard from '../components/ProfileCard.astro';
import TopControls from '../components/TopControls.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchNeoBlogProfile } from '../lib/neo-blog';

const profile = await fetchNeoBlogProfile();
const siteOrigin = (Astro.site?.toString() || siteConfig.siteUrl).replace(/\/$/, '');

const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	url: `${siteOrigin}/`,
	image: `${siteOrigin}${profile.avatar}`,
	description: profile.description.zh,
	jobTitle: profile.role.en,
	sameAs: [
		...profile.ctaLinks.map((item) => item.href),
		...profile.socialLinks.map((item) => item.href),
	],
};
---

<BaseLayout
	title={profile.title}
	description={profile.description.zh}
	author={profile.name}
	canonicalPath="/"
	preloadImage={profile.banner}
	bgDataUri={profile.bannerBgDataUri}
	ogImage={{
		url: `${siteOrigin}${profile.banner}`,
		width: profile.bannerWidth,
		height: profile.bannerHeight,
	}}
	jsonLd={personJsonLd}
>
	<TopControls />
	<div class="page-wrapper">
		<ProfileCard profile={profile} />
	</div>
</BaseLayout>
