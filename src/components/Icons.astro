---
import type { IconChildNode, ResolvedIconSpec } from '../lib/social-icons';

export type IconName = 'blog' | 'status' | 'sun' | 'monitor' | 'moon' | 'globe' | 'chevron-down';

interface Props {
	name?: IconName;
	spec?: ResolvedIconSpec;
	class?: string;
}

const { name, spec, class: className = 'icon' } = Astro.props;

const ALLOWED_TAGS = new Set([
	'path',
	'circle',
	'rect',
	'polygon',
	'polyline',
	'line',
	'ellipse',
	'g',
]);

function escapeAttr(val: string): string {
	return val
		.replace(/&/g, '&amp;')
		.replace(/"/g, '&quot;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;');
}

function renderNodesHtml(nodes: IconChildNode[]): string {
	let out = '';
	for (const node of nodes) {
		if (!ALLOWED_TAGS.has(node.tag)) continue;
		const attrs = Object.entries(node.attr ?? {})
			.filter(([k]) => /^[a-zA-Z][a-zA-Z0-9-]*$/.test(k))
			.map(([k, v]) => `${k}="${escapeAttr(String(v))}"`)
			.join(' ');
		const open = attrs ? `<${node.tag} ${attrs}` : `<${node.tag}`;
		if (node.child && node.child.length > 0) {
			out += `${open}>${renderNodesHtml(node.child)}</${node.tag}>`;
		} else {
			out += `${open}/>`;
		}
	}
	return out;
}
---

{
	spec && (
		<svg
			class={className}
			viewBox={spec.viewBox || '0 0 24 24'}
			fill={spec.stroke ? 'none' : 'currentColor'}
			stroke={spec.stroke ? 'currentColor' : undefined}
			stroke-width={spec.stroke ? '2' : undefined}
			stroke-linecap={spec.stroke ? 'round' : undefined}
			stroke-linejoin={spec.stroke ? 'round' : undefined}
			aria-hidden="true"
			set:html={renderNodesHtml(spec.nodes)}
		/>
	)
}
{
	name === 'blog' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
			<path d="M8 7h8" />
			<path d="M8 11h6" />
		</svg>
	)
}
{
	name === 'status' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" />
		</svg>
	)
}
{
	name === 'sun' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2" />
			<path d="M12 20v2" />
			<path d="m4.93 4.93 1.41 1.41" />
			<path d="m17.66 17.66 1.41 1.41" />
			<path d="M2 12h2" />
			<path d="M20 12h2" />
			<path d="m6.34 17.66-1.41 1.41" />
			<path d="m19.07 4.93-1.41 1.41" />
		</svg>
	)
}
{
	name === 'monitor' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect width="20" height="14" x="2" y="3" rx="2" />
			<line x1="8" x2="16" y1="21" y2="21" />
			<line x1="12" x2="12" y1="17" y2="21" />
		</svg>
	)
}
{
	name === 'moon' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
		</svg>
	)
}
{
	name === 'globe' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="10" />
			<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
			<path d="M2 12h20" />
		</svg>
	)
}
{
	name === 'chevron-down' && (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="m6 9 6 6 6-6" />
		</svg>
	)
}
